{
	"name": "fraym-aisdk-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Minimal Fraym host driving a Vercel AI SDK model fully in the browser",
	"scripts": {
		"dev": "vite --host localhost --port 5187 --strictPort",
		"build": "vite build",
		"preview": "vite preview --host localhost --port 5187 --strictPort",
		"check:types": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@ai-sdk/openai-compatible": "1",
		"@fraym-ai/driver": "workspace:*",
		"@fraym-ai/host": "workspace:*",
		"@fraym-ai/driver-aisdk": "workspace:*",
		"@fraym-ai/ui": "workspace:*",
		"ai": "5",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "latest",
		"tailwindcss": "^4.3.0",
		"vite": "latest"
	}
}
