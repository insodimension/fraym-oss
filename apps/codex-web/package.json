{
	"name": "fraym-codex-web",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"description": "Minimal Fraym host backed by the real local Codex CLI",
	"scripts": {
		"dev": "vite --host localhost --port 5186 --strictPort",
		"build": "vite build",
		"preview": "vite preview --host localhost --port 5186 --strictPort",
		"check:types": "tsc -p tsconfig.json --noEmit"
	},
	"dependencies": {
		"@fraym/driver": "workspace:*",
		"@fraym/host": "workspace:*",
		"@fraym/driver-codex": "workspace:*",
		"@fraym/ui": "workspace:*",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"@vitejs/plugin-react": "latest",
		"tailwindcss": "^4.3.0",
		"vite": "latest"
	}
}
