{
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "skipLibCheck": true
  },
  "include": ["src"],
  "exclude": [
    "src/entries/backgrounds.tsx",
    "src/entries/components.tsx",
    "src/entries/components-core.tsx",
    "src/entries/elements.tsx",
    "src/entries/pages.tsx",
    "src/fixtures/analytics-snapshot.ts",
    "src/fixtures/ask-picker.ts",
    "src/fixtures/ast-operations.ts",
    "src/fixtures/cities.ts",
    "src/fixtures/composer-data.ts",
    "src/fixtures/context-breakdown.ts",
    "src/fixtures/debug-outputs.ts",
    "src/fixtures/diagram-edges.ts",
    "src/fixtures/dock-tabs.ts",
    "src/fixtures/engine-config-catalog.fixture.ts",
    "src/fixtures/file-tree.ts",
    "src/fixtures/index-core.tsx",
    "src/fixtures/index.tsx",
    "src/fixtures/notebook-cells.ts",
    "src/fixtures/planning.ts",
    "src/fixtures/read-contents.ts",
    "src/fixtures/reasoning-traces.ts",
    "src/fixtures/search-results.ts",
    "src/fixtures/session-groups.ts",
    "src/fixtures/ssh-outputs.ts",
    "src/fixtures/task-engine.ts",
    "src/fixtures/terminal-outputs.ts",
    "src/fixtures/todo-phases.ts",
    "src/fixtures/usage-accounts.ts"
  ]
}
