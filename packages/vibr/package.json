{
  "name": "@fraym/vibr",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Animated presence avatars and stream wisps for agent interfaces.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./presence": {
      "types": "./src/presence.tsx",
      "import": "./src/presence.tsx"
    },
    "./nebula": {
      "types": "./src/avatars/nebula.tsx",
      "import": "./src/avatars/nebula.tsx"
    },
    "./smiley": {
      "types": "./src/avatars/smiley.tsx",
      "import": "./src/avatars/smiley.tsx"
    }
  },
  "files": ["src", "README.md", "LICENSE", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.8.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  }
}
