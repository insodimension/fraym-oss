{
  "name": "@fraym-ai/ui",
  "version": "0.1.0",
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./elements": {
      "types": "./src/elements/index.ts",
      "import": "./src/elements/index.ts"
    },
    "./components": {
      "types": "./src/components/index.ts",
      "import": "./src/components/index.ts"
    },
    "./registries": {
      "types": "./src/registries/index.ts",
      "import": "./src/registries/index.ts"
    },
    "./features": {
      "types": "./src/features/index.ts",
      "import": "./src/features/index.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    },
    "./theme.css": "./src/theme/theme.css",
    "./fonts.css": "./src/theme/fonts.css",
    "./aerogel.css": "./src/theme/aerogel.css",
    "./architecture.css": "./src/theme/architecture.css",
    "./cassette-futurism.css": "./src/theme/cassette-futurism.css",
    "./liquid-glass.css": "./src/theme/liquid-glass.css"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fraym-ai/config": "workspace:*",
    "@fraym-ai/driver": "workspace:*",
    "@fraym-ai/verber": "workspace:*",
    "@fraym-ai/vibr": "workspace:*",
    "@lezer/highlight": "^1.2.3",
    "@pierre/trees": "1.0.0-beta.4",
    "@streamdown/code": "^1.1.1",
    "@uiw/react-codemirror": "^4.25.10",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "mermaid": "^11.12.2",
    "radix-ui": "^1.4.2",
    "pdfjs-dist": "^6.1.200",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./elements": {
        "types": "./dist/elements/index.d.ts",
        "import": "./dist/elements/index.js"
      },
      "./components": {
        "types": "./dist/components/index.d.ts",
        "import": "./dist/components/index.js"
      },
      "./registries": {
        "types": "./dist/registries/index.d.ts",
        "import": "./dist/registries/index.js"
      },
      "./features": {
        "types": "./dist/features/index.d.ts",
        "import": "./dist/features/index.js"
      },
      "./theme": {
        "types": "./dist/theme/index.d.ts",
        "import": "./dist/theme/index.js"
      },
      "./theme.css": "./dist/theme/theme.css",
      "./fonts.css": "./dist/theme/fonts.css",
      "./aerogel.css": "./dist/theme/aerogel.css",
      "./architecture.css": "./dist/theme/architecture.css",
      "./cassette-futurism.css": "./dist/theme/cassette-futurism.css",
      "./liquid-glass.css": "./dist/theme/liquid-glass.css"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run ../../scripts/build-package.ts",
    "prepack": "bun run build && bun run ../../scripts/publish-manifest.ts apply",
    "postpack": "bun run ../../scripts/publish-manifest.ts restore",
    "check-tiers": "node scripts/check-tiers.mjs"
  }
}
