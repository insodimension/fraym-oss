// Publish build: emits JS + declarations (the dev config is declaration-only for
// `tsc -b`) and keeps tests out of dist/. The project reference to ../driver is
// dropped here — non-composite emit resolves @fraym-ai/driver through the workspace
// link, which is what the published package will do through its own dist types.
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "emitDeclarationOnly": false,
    "sourceMap": true,
    "noEmitOnError": true
  },
  "references": [],
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
