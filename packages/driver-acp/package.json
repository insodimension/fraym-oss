{
  "name": "@fraym-ai/driver-acp",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": ["dist", "src", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "bun run ../../scripts/build-package.ts",
    "prepack": "bun run build && bun run ../../scripts/publish-manifest.ts apply",
    "postpack": "bun run ../../scripts/publish-manifest.ts restore",
    "test": "bun test"
  },
  "dependencies": {
    "@fraym-ai/driver": "workspace:*"
  }
}
