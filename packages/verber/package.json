{
  "name": "@fraym/verber",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Working-status language for agent interfaces.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./*.js": "./src/*.ts"
  },
  "files": ["src", "README.md", "LICENSE", "!src/**/*.test.ts", "!src/**/*.test.tsx"],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "typescript": "^5.8.0"
  }
}
