{
	"note": "Theme-invariant Fraym tokens (radius, type ramp, spacing, geometry). These do NOT change across themes.",
	"tokens": {
		"--fr-ui-size": "14px",
		"--fr-code-size": "12px",
		"--fr-contrast": "50",
		"--fr-ui-scale": "calc(var(--fr-ui-size) / 14px)",
		"--fr-text-2": "color-mix(in oklab, color-mix(in oklab, var(--fr-text-2-base), var(--fr-text) calc(max(0, var(--fr-contrast) - 50) * 2%)), var(--fr-bg) calc(max(0, 50 - var(--fr-contrast)) * 2%))",
		"--fr-text-3": "color-mix(in oklab, color-mix(in oklab, var(--fr-text-3-base), var(--fr-text) calc(max(0, var(--fr-contrast) - 50) * 2%)), var(--fr-bg) calc(max(0, 50 - var(--fr-contrast)) * 2%))",
		"--fr-del-line": "color-mix(in srgb, var(--fr-del) 34%, transparent)",
		"--fr-explainer-grad-start": "rgba(183, 140, 255, 0.07)",
		"--fr-accent-grad": "var(--fr-accent)",
		"--fr-accent-grad-hover": "var(--fr-accent-2)",
		"--fr-add-grad": "var(--fr-add)",
		"--fr-blue-grad": "var(--fr-blue)",
		"--fr-warn-grad": "var(--fr-warn)",
		"--fr-del-grad": "var(--fr-del)",
		"--fr-r": "10px",
		"--fr-rail-w": "264px",
		"--fr-dock-w": "380px",
		"--fr-input-r": "8px",
		"--fr-input-px": "11px",
		"--fr-textarea-r": "14px",
		"--fr-textarea-px": "14px",
		"--fr-textarea-py": "13px",
		"--fr-textarea-min-h": "24px",
		"--fr-textarea-max-h": "160px",
		"--fr-font-primary": "\"IBM Plex Sans\", -apple-system, BlinkMacSystemFont, sans-serif",
		"--fr-font-display": "var(--fr-font-primary)",
		"--fr-font-rail": "var(--fr-font-primary)",
		"--fr-font-mono": "\"IBM Plex Mono\", ui-monospace, monospace",
		"--fr-font-secondary": "var(--fr-font-mono)",
		"--fr-sans": "var(--fr-font-primary)",
		"--fr-mono": "var(--fr-font-mono)",
		"--fr-fs-2xs": "calc(10.5px * var(--fr-ui-scale))",
		"--fr-fs-xs": "calc(11.5px * var(--fr-ui-scale))",
		"--fr-fs-sm": "calc(12.5px * var(--fr-ui-scale))",
		"--fr-fs-base": "calc(13px * var(--fr-ui-scale))",
		"--fr-fs-md": "calc(14px * var(--fr-ui-scale))",
		"--fr-fs-lg": "calc(15px * var(--fr-ui-scale))",
		"--fr-fs-xl": "calc(18px * var(--fr-ui-scale))",
		"--fr-fs-2xl": "calc(22px * var(--fr-ui-scale))",
		"--fr-fs-3xl": "calc(28px * var(--fr-ui-scale))",
		"--fr-tracking-tight": "0.01em",
		"--fr-tracking-label": "0.04em",
		"--fr-tracking-caps": "0.06em",
		"--fr-switch-thumb-off": "#6a6a72",
		"--fr-btn-hover-bd": "#34343a",
		"--fr-accent-grad-on": "linear-gradient(135deg, #4f8cff, #7a60c1 55%, #a060c0)",
		"--fr-accent-grad-on-hover": "linear-gradient(135deg, #5f97ff, #8a70d1 55%, #b070d0)"
	}
}
